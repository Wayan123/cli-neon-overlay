{
  "name": "cli-neon-overlay",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Wireframe animal companions: native OMP/Pi overlays and an isolated companion pane for Codex, Claude Code and other terminal CLIs",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "companion": "node scripts/companion.mjs",
    "install:omp": "node scripts/install.mjs omp",
    "install:pi": "node scripts/install.mjs pi",
    "install:both": "node scripts/install.mjs both",
    "uninstall:omp": "node scripts/install.mjs omp --uninstall",
    "uninstall:pi": "node scripts/install.mjs pi --uninstall"
  },
  "engines": { "node": ">=22" },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wayan123/cli-neon-overlay.git"
  },
  "keywords": ["terminal", "neon", "pets", "codex", "claude-code", "tmux", "omp", "pi", "ascii", "braille"]
}
